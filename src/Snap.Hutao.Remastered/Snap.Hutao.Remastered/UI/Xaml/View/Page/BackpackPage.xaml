<shuxc:ScopedPage
    x:Class="Snap.Hutao.Remastered.UI.Xaml.View.Page.BackpackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cw="using:CommunityToolkit.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mxi="using:Microsoft.Xaml.Interactivity"
    xmlns:shuxb="using:Snap.Hutao.Remastered.UI.Xaml.Behavior"
    xmlns:shuxc="using:Snap.Hutao.Remastered.UI.Xaml.Control"
    xmlns:shuxcc="using:Snap.Hutao.Remastered.UI.Xaml.Control.Card"
    xmlns:shuxdcs="using:Snap.Hutao.Remastered.UI.Xaml.Data.Converter.Specialized"
    xmlns:shuxm="using:Snap.Hutao.Remastered.UI.Xaml.Markup"
    xmlns:shv="using:Snap.Hutao.Remastered.ViewModel.Backpack"
    d:DataContext="{d:DesignInstance shv:BackpackViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <shuxdcs:UInt32ToGradientColorConverter
                        x:Key="CountToGradientColorConverter"
                        Maximum="#FFFD0093"
                        Minimum="#FF4B00D9"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <shuxdcs:UInt32ToGradientColorConverter
                        x:Key="CountToGradientColorConverter"
                        Maximum="#FFFF69BF"
                        Minimum="#FF9F69FF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Weapon card -->
        <DataTemplate x:Key="WeaponCardTemplate" x:DataType="shv:BackpackWeaponItemView">
            <shuxcc:HorizontalCard Width="270">
                <shuxcc:HorizontalCard.Left>
                    <shuxc:ItemIcon
                        Width="44"
                        Height="44"
                        Icon="{Binding Weapon.Icon, Converter={StaticResource EquipIconConverter}}"
                        Quality="{Binding Weapon.RankLevel}"/>
                </shuxcc:HorizontalCard.Left>
                <shuxcc:HorizontalCard.Right>
                    <Grid Margin="16,0">
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Text="{Binding Weapon.Name}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"/>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{Binding WeaponTypeName}"/>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding LevelRefinementInfo}"/>
                        </StackPanel>
                    </Grid>
                </shuxcc:HorizontalCard.Right>
            </shuxcc:HorizontalCard>
        </DataTemplate>

        <DataTemplate x:Key="ReliquaryCardTemplate" x:DataType="shv:BackpackReliquaryItemView">
            <Border Width="320" Style="{StaticResource BorderShimmerStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Padding="12"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <shuxc:ItemIcon
                            Grid.Column="0"
                            Width="48"
                            Height="48"
                            Icon="{Binding Reliquary.Icon, Converter={StaticResource ItemIconConverter}}"
                            Quality="{Binding Reliquary.RankLevel}"/>
                        <Grid Grid.Column="1">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Reliquary.Name}"/>
                                <TextBlock
                                    Opacity="0.7"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding SetName}"/>
                            </StackPanel>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Style="{StaticResource BaseTextBlockStyle}">
                                <Run Text="+"/>
                                <Run Text="{Binding Level}"/>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                    <Grid Grid.Row="2" Padding="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            FontWeight="Bold"
                            Style="{StaticResource BaseTextBlockStyle}"
                            Text="{Binding MainPropName}"/>
                        <TextBlock
                            Grid.Column="1"
                            FontWeight="Bold"
                            Style="{StaticResource BaseTextBlockStyle}"
                            Text="{Binding MainPropValue}"/>
                    </Grid>

                    <Rectangle
                        Grid.Row="3"
                        Height="1"
                        Fill="{ThemeResource ControlStrokeColorDefaultBrush}"/>

                    <ItemsControl
                        Grid.Row="4"
                        Margin="0,12"
                        ItemsSource="{Binding PaddedSubStats}"
                        ItemTemplate="{StaticResource BackpackReliquarySubStatTemplate}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BackpackReliquarySubStatTemplate" x:DataType="shv:BackpackReliquarySubStatView">
            <Grid Padding="12,0" ColumnSpacing="6" MinHeight="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{Binding DisplayName}"
                    TextWrapping="NoWrap"
                    Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding DisplayValue}"
                    Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Grid Grid.Column="2" Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Ellipse
                        Width="16"
                        Height="16"
                        Opacity="0.8"
                        StrokeThickness="1">
                        <Ellipse.Stroke>
                            <SolidColorBrush Color="{Binding EnhancedCount, Converter={ThemeResource CountToGradientColorConverter}}"/>
                        </Ellipse.Stroke>
                    </Ellipse>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{ThemeResource InfoBadgeValueFontSize}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{Binding EnhancedCount}">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{Binding EnhancedCount, Converter={ThemeResource CountToGradientColorConverter}}"/>
                        </TextBlock.Foreground>
                    </TextBlock>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Default card -->
        <DataTemplate x:Key="DefaultCardTemplate" x:DataType="shv:BackpackItemView">
            <shuxcc:HorizontalCard Width="270">
                <shuxcc:HorizontalCard.Left>
                    <shuxc:ItemIcon
                        Width="40"
                        Height="40"
                        Icon="{Binding Material.Icon, Converter={StaticResource ItemIconConverter}}"
                        Quality="{Binding Material.RankLevel}"/>
                </shuxcc:HorizontalCard.Left>
                <shuxcc:HorizontalCard.Right>
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{Binding Material.Name}"
                            TextTrimming="CharacterEllipsis"/>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{Binding DisplayCount}"/>
                    </Grid>
                </shuxcc:HorizontalCard.Right>
            </shuxcc:HorizontalCard>
        </DataTemplate>

        <shv:BackpackItemTemplateSelector
            x:Key="BackpackItemTemplateSelector"
            DefaultTemplate="{StaticResource DefaultCardTemplate}"
            ReliquaryTemplate="{StaticResource ReliquaryCardTemplate}"
            WeaponTemplate="{StaticResource WeaponCardTemplate}"/>
        </ResourceDictionary>
    </Page.Resources>

    <mxi:Interaction.Behaviors>
        <shuxb:InvokeCommandOnLoadedBehavior Command="{Binding LoadCommand}"/>
    </mxi:Interaction.Behaviors>

    <shuxc:StandardView
        HideCondition="{Binding IsInitialized, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
        ShowCondition="{Binding Archives.CurrentItem, Converter={StaticResource EmptyObjectToBoolConverter}, Mode=OneWay}">
        <shuxc:StandardView.EmptyContent>
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                <Border
                    MinWidth="480"
                    Padding="16"
                    Style="{ThemeResource AcrylicBorderCardStyle}">
                    <StackPanel>
                        <Image
                            Width="120"
                            Height="120"
                            Source="ms-appx:///Resource/Navigation/Backpack.png"/>
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{shuxm:ResourceString Name=ViewPageBackpackAddArchiveHint}"/>
                        <Button
                            Margin="0,16,0,0"
                            Padding="16,8"
                            HorizontalAlignment="Stretch"
                            Command="{Binding AddArchiveCommand}"
                            Content="{shuxm:ResourceString Name=ViewPageBackpackAddArchive}"/>
                    </StackPanel>
                </Border>
            </Border>
        </shuxc:StandardView.EmptyContent>

        <Pivot
            SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
            Style="{ThemeResource CardPivotStyle}">
            <Pivot.RightHeader>
                <CommandBar DefaultLabelPosition="Right" Background="Transparent">
                    <AppBarElementContainer AllowFocusOnInteraction="True">
                        <shuxc:SizeRestrictedContentControl Margin="2,6,3,6">
                            <ComboBox
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Archives}"
                                SelectedItem="{Binding Archives.CurrentItem, Mode=TwoWay}"
                                Style="{ThemeResource CommandBarComboBoxStyle}"/>
                        </shuxc:SizeRestrictedContentControl>
                    </AppBarElementContainer>
                    <AppBarButton
                        Command="{Binding AddArchiveCommand}"
                        Icon="{shuxm:FontIcon Glyph=&#xE710;}"
                        Label="{shuxm:ResourceString Name=ViewPageBackpackAddArchive}"/>
                    <AppBarButton
                        Command="{Binding RemoveArchiveCommand}"
                        Icon="{shuxm:FontIcon Glyph=&#xE74D;}"
                        Label="{shuxm:ResourceString Name=ViewPageBackpackRemoveArchive}"/>
                    <AppBarSeparator/>
                    <AppBarButton
                        Command="{Binding RefreshByEmbeddedYaeCommand}"
                        Icon="{shuxm:FontIcon Glyph=&#xE72C;}"
                        Label="{shuxm:ResourceString Name=ViewPageBackpackRefreshByEmbeddedYae}"/>
                </CommandBar>
            </Pivot.RightHeader>

            <PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryWeapon}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </Border>
                </Border>
            </PivotItem>
            <PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryReliquary}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </Border>
                </Border>
            </PivotItem>
            <PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryUpgradeItem}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </Border>
                </Border>
            </PivotItem>
            <PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryFood}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </Border>
                </Border>
            </PivotItem>
            <PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryMaterial}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </Border>
                </Border>
            </PivotItem>
            <PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryGadget}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </Border>
                </Border>
            </PivotItem>
            <PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryQuest}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </Border>
                </Border>
            </PivotItem>
            <PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryPreciousItem}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </Border>
                </Border>
            </PivotItem>
            <!--<PivotItem Header="{shuxm:ResourceString Name=ViewPageBackpackCategoryFurniture}">
                <Border Margin="16" cw:Effects.Shadow="{ThemeResource CompatCardShadow}">
                    <Border Style="{ThemeResource AcrylicBorderCardStyle}">
                        <GridView
                            Padding="16,16,10,10"
                            ItemTemplateSelector="{StaticResource BackpackItemTemplateSelector}"
                            ItemsSource="{Binding Items}"
                            SelectionMode="None">
                            <GridView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource DefaultGridViewItemStyle}" TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Margin" Value="0,0,6,6"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </Border>
                </Border>
            </PivotItem>-->
        </Pivot>
    </shuxc:StandardView>
</shuxc:ScopedPage>
